#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PYTHON="$ROOT/vendor/jeffy/.venv/bin/python"
if [ ! -x "$PYTHON" ]; then
    echo "Run ./scripts/setup-jeffy.sh to install the local environment." >&2
    exit 1
fi
export HF_HOME="${HF_HOME:-$ROOT/vendor/jeffy/cache/huggingface}"
# English encoder is cached by the installation. Runtime never calls an LLM/API.
export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-false}"
exec "$PYTHON" "$ROOT/scripts/support_cli.py" "$@"
